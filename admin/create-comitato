app.post(
  '/admin/create-comitato',
  requireRole('superadmin'),
  async (req, res) => {
    const { email, password, province } = req.body;

    if (!email || !password || !province) {
      return res.status(400).json({ message: 'Campi mancanti' });
    }

    try {
      // 1️⃣ controllo email duplicata
      const check = await pool.query(
        'SELECT id FROM users WHERE email=$1',
        [email]
      );

      if (check.rows.length > 0) {
        return res.status(409).json({
          message: 'Esiste già un comitato con questa email'
        });
      }

      // 2️⃣ crea COMMITTEE
      const committeeResult = await pool.query(
        `
        INSERT INTO committees (name, province)
        VALUES ($1, $2)
        RETURNING id, name, province
        `,
        [province, province]
      );

      const committee = committeeResult.rows[0];

      // 3️⃣ crea UTENTE collegato al committee
      const hash = await bcrypt.hash(password.trim(), 10);

      const userResult = await pool.query(
        `
        INSERT INTO users (email, password_hash, role, province, committee_id)
        VALUES ($1, $2, 'comitato', $3, $4)
        RETURNING id, email, role, committee_id
        `,
        [email, hash, province, committee.id]
      );

      res.status(201).json({
        message: 'Comitato creato correttamente',
        committee,
        user: userResult.rows[0]
      });

    } catch (err) {
      console.error('ERRORE CREA COMITATO:', err);
      res.status(500).json({ message: 'Errore server' });
    }
  }
);
