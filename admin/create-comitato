app.post(
  '/admin/create-comitato',
  requireRole('superadmin'),
  async (req, res) => {
    const { email, password, province } = req.body;

    if (!email || !password || !province) {
      return res.status(400).json({ message: 'Campi mancanti' });
    }

    const client = await pool.connect();

    try {
      await client.query('BEGIN');

      // 1️⃣ controllo email duplicata su USERS
      const checkUser = await client.query(
        'SELECT id FROM users WHERE email=$1',
        [email]
      );

      if (checkUser.rows.length > 0) {
        await client.query('ROLLBACK');
        return res.status(409).json({
          message: 'Esiste già un comitato con questa email'
        });
      }

      // 2️⃣ crea COMMITTEE (⚠️ CON EMAIL)
      const committeeResult = await client.query(
        `
        INSERT INTO committees (name, email, province)
        VALUES ($1, $2, $3)
        RETURNING id
        `,
        [province, email, province]
      );

      const committeeId = committeeResult.rows[0].id;

      // 3️⃣ crea UTENTE collegato al committee
      const hash = await bcrypt.hash(password.trim(), 10);

      await client.query(
        `
        INSERT INTO users (email, password_hash, role, province, committee_id)
        VALUES ($1, $2, 'comitato', $3, $4)
        `,
        [email, hash, province, committeeId]
      );

      await client.query('COMMIT');

      res.status(201).json({
        message: 'Comitato creato correttamente'
      });

    } catch (err) {
      await client.query('ROLLBACK');
      console.error('ERRORE CREA COMITATO:', err);
      res.status(500).json({ message: 'Errore creazione comitato' });
    } finally {
      client.release();
    }
  }
);
